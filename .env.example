COMPOSE_PROJECT_NAME=birthdayplatform
SPRING_PROFILES_ACTIVE=docker

POSTGRES_IMAGE=postgres:17-alpine
DB_USER=birthday
DB_PASSWORD=change-me

IDENTITY_DB_NAME=identity
IDENTITY_DB_PORT=5433
IDENTITY_DB_URL=jdbc:postgresql://identityDb:5432/identity

GIFT_DB_NAME=gift
GIFT_DB_PORT=5434
GIFT_DB_URL=jdbc:postgresql://giftDb:5432/gift

CHAT_DB_NAME=chat
CHAT_DB_PORT=5435
CHAT_DB_URL=jdbc:postgresql://chatDb:5432/chat

NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_PORT=5436
NOTIFICATION_DB_URL=jdbc:postgresql://notificationDb:5432/notification

GATEWAY_PORT=6767
IDENTITY_SERVICE_PORT=6701
GIFT_SERVICE_PORT=6702
CHAT_SERVICE_PORT=6703
NOTIFICATION_SERVICE_PORT=6704

IDENTITY_SERVICE_URL=http://identityService:6701
GIFT_SERVICE_URL=http://giftService:6702
CHAT_SERVICE_URL=http://chatService:6703
CHAT_SERVICE_WS_URL=ws://chatService:6703
NOTIFICATION_SERVICE_URL=http://notificationService:6704

API_GATEWAY_IMAGE=birthdayplatform/api-gateway:local
IDENTITY_SERVICE_IMAGE=birthdayplatform/identity-service:local
GIFT_SERVICE_IMAGE=birthdayplatform/gift-service:local
CHAT_SERVICE_IMAGE=birthdayplatform/chat-service:local
NOTIFICATION_SERVICE_IMAGE=birthdayplatform/notification-service:local

OPENFEIGN_CONNECT_TIMEOUT=1000
OPENFEIGN_READ_TIMEOUT=2000
